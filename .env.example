# First milestone: Unraid RTSP endpoint
UNRAID_IP=192.0.2.10
RTSP_PORT=8554
RTSP_BASE=rtsp://mediamtx:8554
RTSP_PATH=blink-mini

# Fill after pairing in the Blink app and running the interactive auth/list tool.
# Exact name OR serial is sufficient. If both are set, both must match.
BLINK_CAMERA_NAME=
BLINK_CAMERA_SERIAL=
BLINK_CREDENTIALS_FILE=/data/credentials.json
BLINK_STATE=/data/auth.json
# 2FA is prompted interactively, never stored in .env.
# Mini cameras: extended requests the app's extended_liveview intent.
# Requires camera/account support; regular/battery models should use normal.
BLINK_LIVEVIEW_MODE=normal
# Set 0 to use Blink's duration; do not truncate extended mode at four minutes.
SESSION_SECONDS=0

# Optional ONVIF stage: use an EXISTING Unraid LAN Docker network.
# Verify its actual name using docker network ls; do not create/alter br0 blindly.
UNRAID_LAN_NETWORK=br0
# Set a reserved, unused LAN IP before enabling ONVIF. Do not use 192.0.2.10.
ONVIF_IP=
ONVIF_ID=blink-mini-poc
ONVIF_NAME=Blink Mini PoC
ONVIF_UUID=
ONVIF_MAC=

# Optional explicit SHA256 certificate pin for self-signed IMMIS endpoints.
# Empty uses standard CA/hostname verification. Never automatically refresh a pin.
BLINK_IMMIS_CERT_SHA256=

# Disable discovery after adoption if Protect shows duplicate candidates.
ONVIF_DISCOVERY_ENABLED=true

# Generate a fresh UUID and locally administered MAC per virtual camera.
# Optional published images (set after the first successful Actions run):
# BRIDGE_IMAGE=ghcr.io/centauri/blink-camera-relay:latest
# ONVIF_IMAGE=ghcr.io/centauri/blink-camera-relay-onvif:latest
